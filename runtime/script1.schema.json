{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One emu-runtime script1 input record",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "format": {
          "const": "emu-runtime-script"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "format",
        "version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "state"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "pause"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "run"
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "op",
        "cycles"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "step"
        },
        "maxCycles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "op",
        "maxCycles"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "reset"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "entry": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "op",
        "seed",
        "entry"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "boardInput"
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,63}$"
        },
        "cycle": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$",
              "maxLength": 20,
              "format": "uint64"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "op",
        "schema",
        "cycle",
        "payload"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "boardInspect"
        },
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,63}$"
        },
        "request": {
          "type": "object"
        }
      },
      "required": [
        "op",
        "schema",
        "request"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "replaceCodeBreakpoints"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "uniqueItems": true,
          "maxItems": 1024
        }
      },
      "required": [
        "op",
        "addresses"
      ],
      "additionalProperties": false
    }
  ]
}
