  "$defs": {
    "snapshot": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "format": "uint64"
        },
        "state": {
          "enum": [
            "paused",
            "running",
            "faulted",
            "terminated"
          ]
        },
        "variant": {
          "enum": [
            "8051",
            "8052",
            "sab80535"
          ]
        },
        "cycle": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "format": "uint64"
        },
        "instructions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "format": "uint64"
        },
        "pc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "registers": {
          "type": "object",
          "properties": {
            "a": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "b": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "psw": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "sp": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "dptr": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "r": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "maxItems": 8,
              "minItems": 8
            }
          },
          "required": [
            "a",
            "b",
            "psw",
            "sp",
            "dptr",
            "r"
          ],
          "additionalProperties": false
        },
        "idle": {
          "type": "boolean"
        },
        "powerDown": {
          "type": "boolean"
        },
        "safeBoundary": {
          "type": "boolean"
        },
        "stopRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "format": "uint64"
        },
        "reason": {
          "enum": [
            "entry",
            "pause",
            "step",
            "breakpoint",
            "watchpoint",
            "exception",
            "cycle-budget",
            "power-down-unsupported",
            "terminated"
          ]
        },
        "imageSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "moduleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "configSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "moduleId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,63}$"
        },
        "moduleVersion": {
          "type": "string",
          "maxLength": 31
        },
        "controlRole": {
          "enum": [
            "observer",
            "controller"
          ]
        },
        "canTerminate": {
          "type": "boolean"
        }
      },
      "required": [
        "sessionId",
        "generation",
        "state",
        "variant",
        "cycle",
        "instructions",
        "pc",
        "registers",
        "idle",
        "powerDown",
        "safeBoundary",
        "stopRevision",
        "reason",
        "imageSha256",
        "moduleSha256",
        "configSha256",
        "moduleId",
        "moduleVersion",
        "controlRole",
        "canTerminate"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "protocol": {
          "type": "object",
          "properties": {
            "major": {
              "const": 2
            },
            "minor": {
              "const": 1
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "additionalProperties": false
        },
        "contractVersion": {
          "const": "0.2.0"
        },
        "runtimeCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "contractManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "enum": [
              "attachSession",
              "status",
              "control",
              "codeBreakpoints",
              "decodeCode",
              "memoryRead",
              "traceRead",
              "boardInput",
              "boardInspect",
              "boardInspectFault"
            ]
          },
          "maxItems": 10,
          "uniqueItems": true,
          "allOf": [
            {
              "if": {
                "contains": {
                  "const": "boardInspectFault"
                }
              },
              "then": {
                "contains": {
                  "const": "boardInspect"
                }
              }
            }
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxFrameBytes": {
              "const": 65536
            },
            "maxConfigBytes": {
              "const": 16384
            },
            "maxInputs": {
              "const": 1024
            },
            "maxPageRecords": {
              "const": 128
            },
            "maxCycleBudget": {
              "const": 100000
            },
            "maxSafeDrainCycles": {
              "const": 16
            },
            "maxClients": {
              "const": 8
            },
            "maxPendingRequests": {
              "const": 32
            },
            "maxBreakpoints": {
              "const": 1024
            },
            "maxMemoryBytes": {
              "const": 256
            },
            "maxDecodeRecords": {
              "const": 256
            },
            "maxBoardPayloadBytes": {
              "const": 4096
            }
          },
          "required": [
            "maxFrameBytes",
            "maxConfigBytes",
            "maxInputs",
            "maxPageRecords",
            "maxCycleBudget",
            "maxSafeDrainCycles",
            "maxClients",
            "maxPendingRequests",
            "maxBreakpoints",
            "maxMemoryBytes",
            "maxDecodeRecords",
            "maxBoardPayloadBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocol",
        "contractVersion",
        "runtimeCommit",
        "contractManifestSha256",
        "capabilities",
        "limits"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INVALID",
            "VERSION",
            "STATE",
            "RANGE",
            "CAPACITY",
            "UNSUPPORTED",
            "BUSY",
            "STALE",
            "DENIED",
            "FAULT",
            "EXHAUSTED",
            "IO",
            "HASH",
            "NOT_FOUND"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "cycles": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "format": "uint64"
        },
        "instructions": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20,
          "format": "uint64"
        }
      },
      "required": [
        "cycles",
        "instructions"
      ],
      "additionalProperties": false
    }
  }
